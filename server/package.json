{
  "name": "stave-server",
  "version": "0.1.0",
  "private": true,
  "description": "Stave API: upload, tag reading, library and streaming",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js | pino-pretty --translateTime SYS:HH:MM:ss --ignore pid,hostname",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.4",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.7",
    "music-metadata": "^12.2.3"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0"
  }
}
